#!/bin/sh
set +x

set -u
LC_ALL=C
export LC_ALL
umask 077

invalid_command() {
    printf '%s\n' \
        '{"error":{"message":"Expected health, transcribe AUDIO_FILE, transcribe-long AUDIO_FILE, or job-get JOB_ID","type":"client_error","param":"command","code":"invalid_command"}}'
    exit 64
}

invalid_audio_file() {
    printf '%s\n' \
        '{"error":{"message":"Audio file must be a readable regular file","type":"client_error","param":"file","code":"invalid_audio_file"}}'
    exit 66
}

invalid_job_id() {
    printf '%s\n' \
        '{"error":{"message":"Job ID must be 8 uppercase Crockford Base32 characters","type":"client_error","param":"job_id","code":"invalid_job_id"}}'
    exit 65
}

curl_not_found() {
    printf '%s\n' \
        '{"error":{"message":"curl is required to use Botified ASR","type":"client_error","param":null,"code":"curl_not_found"}}'
    exit 69
}

invalid_client_config() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR client configuration is invalid","type":"client_error","param":null,"code":"invalid_client_config"}}'
    exit 78
}

validate_port() {
    case "$1" in
        "" | *[!0-9]*)
            return 1
            ;;
    esac
    [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

local_io_error() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR helper could not create private temporary files","type":"client_error","param":null,"code":"local_io_error"}}'
    exit 70
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

if [ "$#" -eq 1 ] && [ "$1" = "health" ]; then
    command_name=health
    audio_file=
    job_id=
elif [ "$#" -eq 2 ] && [ "$1" = "transcribe" ]; then
    command_name=transcribe
    audio_file=$2
    job_id=
elif [ "$#" -eq 2 ] && [ "$1" = "transcribe-long" ]; then
    command_name=transcribe-long
    audio_file=$2
    job_id=
elif [ "$#" -eq 2 ] && [ "$1" = "job-get" ]; then
    command_name=job-get
    audio_file=
    job_id=$2
else
    invalid_command
fi

if ! command -v curl >/dev/null 2>&1; then
    curl_not_found
fi

base_url_is_set=${BOTIFIED_ASR_BASE_URL+x}
api_key_is_set=${BOTIFIED_ASR_API_KEY+x}

if [ "$base_url_is_set" != "$api_key_is_set" ]; then
    invalid_client_config
fi

if [ "$base_url_is_set" = "x" ]; then
    base_url=$BOTIFIED_ASR_BASE_URL
    api_key=$BOTIFIED_ASR_API_KEY
    unset BOTIFIED_ASR_BASE_URL BOTIFIED_ASR_API_KEY
else
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        client_config_root=$XDG_CONFIG_HOME
    else
        if [ -z "${HOME:-}" ]; then
            invalid_client_config
        fi
        client_config_root=$HOME/.config
    fi

    case "$client_config_root" in
        "" | *[[:cntrl:]]*)
            invalid_client_config
            ;;
        /*)
            ;;
        *)
            invalid_client_config
            ;;
    esac

    client_config_path=$client_config_root/botified-asr/client.env
    if [ -L "$client_config_path" ]; then
        invalid_client_config
    fi
    if [ ! -e "$client_config_path" ]; then
        escaped_path=$(json_escape "$client_config_path") ||
            invalid_client_config
        printf \
            '{"error":{"message":"Botified ASR client is not configured","type":"client_error","param":null,"code":"client_not_configured"},"client_config_path":"%s"}\n' \
            "$escaped_path"
        exit 78
    fi
    if [ ! -f "$client_config_path" ]; then
        invalid_client_config
    fi
    client_config_mode=$(
        stat -c '%a' -- "$client_config_path" 2>/dev/null
    ) || invalid_client_config
    if [ "$client_config_mode" != "600" ]; then
        invalid_client_config
    fi

    base_url_seen=0
    api_key_seen=0
    base_url=
    api_key=
    while IFS= read -r config_line || [ -n "$config_line" ]; do
        case "$config_line" in
            "" | *[[:cntrl:]]*)
                invalid_client_config
                ;;
            BOTIFIED_ASR_BASE_URL=*)
                if [ "$base_url_seen" -ne 0 ]; then
                    invalid_client_config
                fi
                base_url=${config_line#BOTIFIED_ASR_BASE_URL=}
                base_url_seen=1
                ;;
            BOTIFIED_ASR_API_KEY=*)
                if [ "$api_key_seen" -ne 0 ]; then
                    invalid_client_config
                fi
                api_key=${config_line#BOTIFIED_ASR_API_KEY=}
                api_key_seen=1
                ;;
            *)
                invalid_client_config
                ;;
        esac
    done <"$client_config_path"
    if [ "$base_url_seen" -ne 1 ] || [ "$api_key_seen" -ne 1 ]; then
        invalid_client_config
    fi
fi

case "$base_url" in
    "" | *[[:space:]]* | *[[:cntrl:]]* | *"@"* | *"?"* | *"#"*)
        invalid_client_config
        ;;
    http://* | https://*)
        ;;
    *)
        invalid_client_config
        ;;
esac

case "$base_url" in
    */)
        origin=${base_url%/}
        ;;
    *)
        origin=$base_url
        ;;
esac
authority=${origin#*://}
case "$authority" in
    "" | */*)
        invalid_client_config
        ;;
esac
case "$authority" in
    *"["* | *"]"* | *"{"* | *"}"*)
        invalid_client_config
        ;;
    *:*)
        origin_host=${authority%%:*}
        origin_port=${authority#*:}
        case "$origin_port" in
            *:*)
                invalid_client_config
                ;;
        esac
        if ! validate_port "$origin_port"; then
            invalid_client_config
        fi
        ;;
    *)
        origin_host=$authority
        ;;
esac
if [ -z "$origin_host" ]; then
    invalid_client_config
fi

key_prefix=${api_key%%=*}
key_padding=${api_key#"$key_prefix"}
case "$key_prefix" in
    "" | *[!A-Za-z0-9._~+/-]*)
        invalid_client_config
        ;;
esac
while [ -n "$key_padding" ]; do
    case "$key_padding" in
        =*)
            key_padding=${key_padding#=}
            ;;
        *)
            invalid_client_config
            ;;
    esac
done

case "$command_name" in
    health | job-get)
        request_input=/dev/null
        ;;
    transcribe | transcribe-long)
        if [ ! -f "$audio_file" ] || [ ! -r "$audio_file" ]; then
            invalid_audio_file
        fi
        request_input=$audio_file
        ;;
esac

if [ "$command_name" = "job-get" ]; then
    case "$job_id" in
        ????????)
            case "$job_id" in
                *[!0-9A-HJKMNP-TV-Z]*)
                    invalid_job_id
                    ;;
            esac
            ;;
        *)
            invalid_job_id
            ;;
    esac
fi

temporary_root=${TMPDIR:-/tmp}
response_body=$(
    mktemp "$temporary_root/botified-asr-body.XXXXXX" 2>/dev/null
) || local_io_error

cleanup() {
    rm -f -- "$response_body"
}
trap cleanup EXIT HUP INT TERM

set -- \
    --disable \
    --globoff \
    --config - \
    --proto '=http,https' \
    --silent \
    --fail-with-body \
    --connect-timeout 5

case "$command_name" in
    health)
        set -- \
            "$@" \
            --max-time 10 \
            --request GET \
            --url "$origin/health/ready"
        ;;
    transcribe | transcribe-long)
        set -- \
            "$@" \
            --request POST
        if [ "$command_name" = "transcribe-long" ]; then
            set -- \
                "$@" \
                --header 'Prefer: respond-async'
        fi
        set -- \
            "$@" \
            --form-string model=sensevoice \
            --form-string response_format=json
        if [ "$command_name" = "transcribe-long" ]; then
            set -- \
                "$@" \
                --form-string chunking_strategy=auto
        fi
        set -- \
            "$@" \
            --form \
            'file=@/dev/fd/3;filename=audio;type=application/octet-stream' \
            --url "$origin/v1/audio/transcriptions"
        ;;
    job-get)
        set -- \
            "$@" \
            --request GET \
            --url "$origin/v1/audio/transcriptions/$job_id"
        ;;
esac

if ! { command exec 3<"$request_input"; } 2>/dev/null; then
    invalid_audio_file
fi

printf 'header = "Authorization: Bearer %s"\n' "$api_key" |
    curl \
        "$@" \
        >"$response_body" 2>/dev/null
curl_status=$?

if [ "$curl_status" -eq 0 ] || [ "$curl_status" -eq 22 ]; then
    cat "$response_body"
    exit "$curl_status"
fi

printf '%s\n' \
    '{"error":{"message":"Botified ASR request failed","type":"client_error","param":null,"code":"curl_failed"}}'
exit "$curl_status"
