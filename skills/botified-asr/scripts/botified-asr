#!/bin/sh
set +x

set -u
LC_ALL=C
export LC_ALL
umask 077

invalid_command() {
    printf '%s\n' \
        '{"error":{"message":"Expected health, transcribe AUDIO_FILE, transcribe-long AUDIO_FILE, job-get JOB_ID, job-wait JOB_ID TIMEOUT_SECONDS, job-delete JOB_ID, speaker-list, speaker-get SPEAKER_ID, or speaker-delete SPEAKER_ID","type":"client_error","param":"command","code":"invalid_command"}}'
    exit 64
}

invalid_audio_file() {
    printf '%s\n' \
        '{"error":{"message":"Audio file must be a readable regular file","type":"client_error","param":"file","code":"invalid_audio_file"}}'
    exit 66
}

invalid_job_id() {
    printf '%s\n' \
        '{"error":{"message":"Job ID must be 8 uppercase Crockford Base32 characters","type":"client_error","param":"job_id","code":"invalid_job_id"}}'
    exit 65
}

invalid_speaker_id() {
    printf '%s\n' \
        '{"error":{"message":"Speaker ID must be 8 uppercase Crockford Base32 characters","type":"client_error","param":"speaker_id","code":"invalid_speaker_id"}}'
    exit 65
}

invalid_timeout_seconds() {
    printf '%s\n' \
        '{"error":{"message":"Timeout seconds must be an integer from 1 through 999999999","type":"client_error","param":"timeout_seconds","code":"invalid_timeout_seconds"}}'
    exit 65
}

job_wait_unavailable() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR job waiting is unavailable","type":"client_error","param":null,"code":"job_wait_unavailable"}}'
    exit 69
}

job_wait_timeout() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR job wait timed out","type":"client_error","param":"timeout_seconds","code":"job_wait_timeout"}}'
    exit 75
}

unexpected_http_response() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR received an unexpected HTTP response","type":"client_error","param":null,"code":"unexpected_http_response"}}'
    exit 76
}

curl_not_found() {
    printf '%s\n' \
        '{"error":{"message":"curl is required to use Botified ASR","type":"client_error","param":null,"code":"curl_not_found"}}'
    exit 69
}

invalid_client_config() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR client configuration is invalid","type":"client_error","param":null,"code":"invalid_client_config"}}'
    exit 78
}

validate_port() {
    case "$1" in
        "" | *[!0-9]*)
            return 1
            ;;
    esac
    [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

is_crockford_id() {
    case "$1" in
        ????????)
            ;;
        *)
            return 1
            ;;
    esac
    case "$1" in
        *[!0-9A-HJKMNP-TV-Z]*)
            return 1
            ;;
    esac
}

local_io_error() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR helper could not create private temporary files","type":"client_error","param":null,"code":"local_io_error"}}'
    exit 70
}

curl_failed() {
    printf '%s\n' \
        '{"error":{"message":"Botified ASR request failed","type":"client_error","param":null,"code":"curl_failed"}}'
    exit "$1"
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

read_monotonic_centiseconds() {
    uptime_contents=$(cat /proc/uptime 2>/dev/null) ||
        job_wait_unavailable
    uptime_value=${uptime_contents%%[[:space:]]*}
    case "$uptime_value" in
        *.*)
            uptime_whole=${uptime_value%%.*}
            uptime_fraction=${uptime_value#*.}
            ;;
        *)
            job_wait_unavailable
            ;;
    esac
    case "$uptime_whole" in
        "" | *[!0-9]*)
            job_wait_unavailable
            ;;
    esac
    case "$uptime_fraction" in
        [0-9][0-9])
            ;;
        *)
            job_wait_unavailable
            ;;
    esac
    while [ "${uptime_whole#0}" != "$uptime_whole" ]; do
        uptime_whole=${uptime_whole#0}
    done
    if [ -z "$uptime_whole" ]; then
        uptime_whole=0
    fi
    if [ "${#uptime_whole}" -gt 15 ]; then
        job_wait_unavailable
    fi
    uptime_tenths=${uptime_fraction%?}
    uptime_hundredths=${uptime_fraction#?}
    now_centiseconds=$((uptime_whole * 100 + uptime_tenths * 10 + uptime_hundredths))
    if [ "$now_centiseconds" -lt 0 ]; then
        job_wait_unavailable
    fi
}

format_centiseconds() {
    duration_whole=$(( $1 / 100 ))
    duration_fraction=$(( $1 % 100 ))
    if [ "$duration_fraction" -lt 10 ]; then
        formatted_duration=$duration_whole.0$duration_fraction
    else
        formatted_duration=$duration_whole.$duration_fraction
    fi
}

read_wait_clock_before_deadline() {
    read_monotonic_centiseconds
    if [ "$now_centiseconds" -ge "$deadline_centiseconds" ]; then
        job_wait_timeout
    fi
}

wait_for_active_child() {
    wait "$active_child_pid"
    active_child_status=$?
    active_child_pid=
    return "$active_child_status"
}

terminate_active_child_and_exit() {
    signal_exit_status=$1
    if [ -n "$active_child_pid" ]; then
        kill -TERM "$active_child_pid" 2>/dev/null || :
        wait "$active_child_pid" 2>/dev/null || :
        active_child_pid=
    fi
    exit "$signal_exit_status"
}

execute_curl() {
    printf 'header = "Authorization: Bearer %s"\n' "$api_key" |
        curl "$@" 2>/dev/null &
    active_child_pid=$!
    wait_for_active_child
}

execute_sleep() {
    sleep "$1" 2>/dev/null &
    active_child_pid=$!
    wait_for_active_child
}

perform_request() {
    execute_curl \
        "$@" \
        --output "$response_body" \
        --write-out '%{http_code}' \
        >"$http_status_body"
    curl_status=$?
    http_code=
    IFS= read -r http_code <"$http_status_body" || :
}

classify_http_response() {
    case "$command_name:$http_code" in
        health:200 | transcribe:200 | transcribe-long:202 | \
            job-get:200 | job-get:202 | job-wait:200 | job-delete:202 | \
            speaker-list:200 | speaker-get:200)
            http_response_kind=body
            ;;
        job-wait:202)
            http_response_kind=active
            ;;
        job-delete:204 | speaker-delete:204)
            http_response_kind=empty
            ;;
        *)
            unexpected_http_response
            ;;
    esac
}

audio_file=
job_id=
speaker_id=
wait_timeout=

if [ "$#" -eq 1 ] && [ "$1" = "health" ]; then
    command_name=health
elif [ "$#" -eq 2 ] && [ "$1" = "transcribe" ]; then
    command_name=transcribe
    audio_file=$2
elif [ "$#" -eq 2 ] && [ "$1" = "transcribe-long" ]; then
    command_name=transcribe-long
    audio_file=$2
elif [ "$#" -eq 2 ] && [ "$1" = "job-get" ]; then
    command_name=job-get
    job_id=$2
elif [ "$#" -eq 2 ] && [ "$1" = "job-delete" ]; then
    command_name=job-delete
    job_id=$2
elif [ "$#" -eq 3 ] && [ "$1" = "job-wait" ]; then
    command_name=job-wait
    job_id=$2
    wait_timeout=$3
elif [ "$#" -eq 1 ] && [ "$1" = "speaker-list" ]; then
    command_name=speaker-list
elif [ "$#" -eq 2 ] && [ "$1" = "speaker-get" ]; then
    command_name=speaker-get
    speaker_id=$2
elif [ "$#" -eq 2 ] && [ "$1" = "speaker-delete" ]; then
    command_name=speaker-delete
    speaker_id=$2
else
    invalid_command
fi

if ! command -v curl >/dev/null 2>&1; then
    curl_not_found
fi

base_url_is_set=${BOTIFIED_ASR_BASE_URL+x}
api_key_is_set=${BOTIFIED_ASR_API_KEY+x}

if [ "$base_url_is_set" != "$api_key_is_set" ]; then
    invalid_client_config
fi

if [ "$base_url_is_set" = "x" ]; then
    base_url=$BOTIFIED_ASR_BASE_URL
    api_key=$BOTIFIED_ASR_API_KEY
    unset BOTIFIED_ASR_BASE_URL BOTIFIED_ASR_API_KEY
else
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        client_config_root=$XDG_CONFIG_HOME
    else
        if [ -z "${HOME:-}" ]; then
            invalid_client_config
        fi
        client_config_root=$HOME/.config
    fi

    case "$client_config_root" in
        "" | *[[:cntrl:]]*)
            invalid_client_config
            ;;
        /*)
            ;;
        *)
            invalid_client_config
            ;;
    esac

    client_config_path=$client_config_root/botified-asr/client.env
    if [ -L "$client_config_path" ]; then
        invalid_client_config
    fi
    if [ ! -e "$client_config_path" ]; then
        escaped_path=$(json_escape "$client_config_path") ||
            invalid_client_config
        printf \
            '{"error":{"message":"Botified ASR client is not configured","type":"client_error","param":null,"code":"client_not_configured"},"client_config_path":"%s"}\n' \
            "$escaped_path"
        exit 78
    fi
    if [ ! -f "$client_config_path" ]; then
        invalid_client_config
    fi
    client_config_mode=$(
        stat -c '%a' -- "$client_config_path" 2>/dev/null
    ) || invalid_client_config
    if [ "$client_config_mode" != "600" ]; then
        invalid_client_config
    fi

    base_url_seen=0
    api_key_seen=0
    base_url=
    api_key=
    while IFS= read -r config_line || [ -n "$config_line" ]; do
        case "$config_line" in
            "" | *[[:cntrl:]]*)
                invalid_client_config
                ;;
            BOTIFIED_ASR_BASE_URL=*)
                if [ "$base_url_seen" -ne 0 ]; then
                    invalid_client_config
                fi
                base_url=${config_line#BOTIFIED_ASR_BASE_URL=}
                base_url_seen=1
                ;;
            BOTIFIED_ASR_API_KEY=*)
                if [ "$api_key_seen" -ne 0 ]; then
                    invalid_client_config
                fi
                api_key=${config_line#BOTIFIED_ASR_API_KEY=}
                api_key_seen=1
                ;;
            *)
                invalid_client_config
                ;;
        esac
    done <"$client_config_path"
    if [ "$base_url_seen" -ne 1 ] || [ "$api_key_seen" -ne 1 ]; then
        invalid_client_config
    fi
fi

case "$base_url" in
    "" | *[[:space:]]* | *[[:cntrl:]]* | *"@"* | *"?"* | *"#"*)
        invalid_client_config
        ;;
    http://* | https://*)
        ;;
    *)
        invalid_client_config
        ;;
esac

case "$base_url" in
    */)
        origin=${base_url%/}
        ;;
    *)
        origin=$base_url
        ;;
esac
authority=${origin#*://}
case "$authority" in
    "" | */*)
        invalid_client_config
        ;;
esac
case "$authority" in
    *"["* | *"]"* | *"{"* | *"}"*)
        invalid_client_config
        ;;
    *:*)
        origin_host=${authority%%:*}
        origin_port=${authority#*:}
        case "$origin_port" in
            *:*)
                invalid_client_config
                ;;
        esac
        if ! validate_port "$origin_port"; then
            invalid_client_config
        fi
        ;;
    *)
        origin_host=$authority
        ;;
esac
if [ -z "$origin_host" ]; then
    invalid_client_config
fi

key_prefix=${api_key%%=*}
key_padding=${api_key#"$key_prefix"}
case "$key_prefix" in
    "" | *[!A-Za-z0-9._~+/-]*)
        invalid_client_config
        ;;
esac
while [ -n "$key_padding" ]; do
    case "$key_padding" in
        =*)
            key_padding=${key_padding#=}
            ;;
        *)
            invalid_client_config
            ;;
    esac
done

case "$command_name" in
    health | job-get | job-wait | job-delete | \
        speaker-list | speaker-get | speaker-delete)
        request_input=/dev/null
        ;;
    transcribe | transcribe-long)
        if [ ! -f "$audio_file" ] || [ ! -r "$audio_file" ]; then
            invalid_audio_file
        fi
        request_input=$audio_file
        ;;
esac

case "$command_name" in
    job-get | job-wait | job-delete)
        if ! is_crockford_id "$job_id"; then
            invalid_job_id
        fi
        ;;
    speaker-get | speaker-delete)
        if ! is_crockford_id "$speaker_id"; then
            invalid_speaker_id
        fi
        ;;
esac

if [ "$command_name" = "job-wait" ]; then
    case "$wait_timeout" in
        "" | *[!0-9]*)
            invalid_timeout_seconds
            ;;
    esac
    while [ "${wait_timeout#0}" != "$wait_timeout" ]; do
        wait_timeout=${wait_timeout#0}
    done
    if [ -z "$wait_timeout" ] || [ "${#wait_timeout}" -gt 9 ]; then
        invalid_timeout_seconds
    fi
    if [ "$wait_timeout" -gt 999999999 ]; then
        invalid_timeout_seconds
    fi
    read_monotonic_centiseconds
    deadline_centiseconds=$((now_centiseconds + wait_timeout * 100))
fi

temporary_root=${TMPDIR:-/tmp}
response_body=
http_status_body=
active_child_pid=

cleanup() {
    if [ -n "$response_body" ]; then
        rm -f -- "$response_body"
    fi
    if [ -n "$http_status_body" ]; then
        rm -f -- "$http_status_body"
    fi
}
trap cleanup EXIT
trap 'terminate_active_child_and_exit 129' HUP
trap 'terminate_active_child_and_exit 130' INT
trap 'terminate_active_child_and_exit 143' TERM

response_body=$(
    mktemp "$temporary_root/botified-asr-body.XXXXXX" 2>/dev/null
) || local_io_error
http_status_body=$(
    mktemp "$temporary_root/botified-asr-http.XXXXXX" 2>/dev/null
) || local_io_error

set -- \
    --disable \
    --globoff \
    --config - \
    --proto '=http,https' \
    --silent \
    --fail-with-body \
    --connect-timeout 5

case "$command_name" in
    health)
        set -- \
            "$@" \
            --max-time 10 \
            --request GET \
            --url "$origin/health/ready"
        ;;
    transcribe | transcribe-long)
        set -- \
            "$@" \
            --request POST
        if [ "$command_name" = "transcribe-long" ]; then
            set -- \
                "$@" \
                --header 'Prefer: respond-async'
        fi
        set -- \
            "$@" \
            --form-string model=sensevoice \
            --form-string response_format=json
        if [ "$command_name" = "transcribe-long" ]; then
            set -- \
                "$@" \
                --form-string chunking_strategy=auto
        fi
        set -- \
            "$@" \
            --form \
            'file=@/dev/fd/3;filename=audio;type=application/octet-stream' \
            --url "$origin/v1/audio/transcriptions"
        ;;
    job-get | job-wait)
        set -- \
            "$@" \
            --request GET \
            --url "$origin/v1/audio/transcriptions/$job_id"
        ;;
    job-delete)
        set -- \
            "$@" \
            --request DELETE \
            --url "$origin/v1/audio/transcriptions/$job_id"
        ;;
    speaker-list)
        set -- \
            "$@" \
            --request GET \
            --url "$origin/v1/speakers"
        ;;
    speaker-get)
        set -- \
            "$@" \
            --request GET \
            --url "$origin/v1/speakers/$speaker_id"
        ;;
    speaker-delete)
        set -- \
            "$@" \
            --request DELETE \
            --url "$origin/v1/speakers/$speaker_id"
        ;;
esac

if ! { command exec 3<"$request_input"; } 2>/dev/null; then
    invalid_audio_file
fi

if [ "$command_name" = "job-wait" ]; then
    backoff_centiseconds=100
    while :; do
        remaining_centiseconds=$((deadline_centiseconds - now_centiseconds))
        if [ "$remaining_centiseconds" -le 0 ]; then
            job_wait_timeout
        fi
        format_centiseconds "$remaining_centiseconds"
        perform_request "$@" --max-time "$formatted_duration"

        if [ "$curl_status" -eq 22 ]; then
            cat "$response_body"
            exit 22
        fi
        if [ "$curl_status" -ne 0 ]; then
            if [ "$curl_status" -eq 28 ]; then
                read_wait_clock_before_deadline
            fi
            curl_failed "$curl_status"
        fi

        classify_http_response
        case "$http_response_kind" in
            body)
                cat "$response_body"
                exit 0
                ;;
            active)
                read_wait_clock_before_deadline
                remaining_centiseconds=$((deadline_centiseconds - now_centiseconds))
                sleep_centiseconds=$backoff_centiseconds
                if [ "$remaining_centiseconds" -lt "$sleep_centiseconds" ]; then
                    sleep_centiseconds=$remaining_centiseconds
                fi
                format_centiseconds "$sleep_centiseconds"
                if ! execute_sleep "$formatted_duration"; then
                    job_wait_unavailable
                fi
                read_wait_clock_before_deadline
                if [ "$backoff_centiseconds" -lt 800 ]; then
                    backoff_centiseconds=$((backoff_centiseconds * 2))
                fi
                ;;
        esac
    done
fi

perform_request "$@"

if [ "$curl_status" -eq 22 ]; then
    cat "$response_body"
    exit 22
fi
if [ "$curl_status" -ne 0 ]; then
    curl_failed "$curl_status"
fi

classify_http_response
if [ "$http_response_kind" = "body" ]; then
    cat "$response_body"
fi
exit 0
