#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import sys
import tempfile
import tomllib
from pathlib import Path


JSON = "application/json"
MULTIPART = "multipart/form-data"
ERROR_CONTENT = {
    JSON: {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
}


def _project_version(project_root: Path) -> str:
    with (project_root / "pyproject.toml").open("rb") as source:
        version = tomllib.load(source)["project"]["version"]
    if not isinstance(version, str) or re.fullmatch(
        r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)",
        version,
    ) is None:
        raise RuntimeError("project.version must be canonical X.Y.Z")
    return version


def _validate_runtime_routes(
    project_root: Path,
    document: dict[str, object],
) -> None:
    from botified_asr.api import Readiness, create_app
    from botified_asr.config import LimitsConfig
    from botified_asr.speakers import SpeakerEmbeddingPolicy
    from botified_asr.storage import Storage

    class InertProcessor:
        def process(self, *_args: object, **_kwargs: object) -> object:
            raise AssertionError("OpenAPI generation must not run inference")

    with tempfile.TemporaryDirectory(prefix="botified-asr-openapi-") as directory:
        storage = Storage(
            Path(directory),
            LimitsConfig(),
            current_processor_fingerprint="0" * 64,
            free_bytes=lambda _path: 1 << 60,
        )
        try:
            app = create_app(
                api_key="openapi-generation",
                readiness=Readiness(True, True, True),
                storage=storage,
                processor=InertProcessor(),
                speaker_embedding_policy=SpeakerEmbeddingPolicy(
                    model_id="funasr/campplus",
                    model_revision="0" * 40,
                    embedding_dimension=192,
                    sample_rate=16_000,
                    downmix_policy_version="ffmpeg-first-audio-stream-ac1-v1",
                    window_samples=24_000,
                    window_shift_samples=12_000,
                    padding_policy_version="right-zero-pad-v1",
                    normalization_policy_version="int16-div-32768-l2-v1",
                    enrollment_aggregation_policy_version=(
                        "sample-centroid-equal-average-v1"
                    ),
                ),
                audio_prober=lambda *_args: None,
                processor_fingerprint="0" * 64,
                close_storage_on_shutdown=False,
            )
            actual = {
                (method, route.path)
                for route in app.routes
                for method in (route.methods or ())
                if method != "HEAD"
            }
        finally:
            storage.close()
    documented = {
        (method.upper(), path)
        for path, path_item in document["paths"].items()
        for method in path_item
    }
    if actual != documented:
        missing = sorted(documented - actual)
        unexpected = sorted(actual - documented)
        raise RuntimeError(
            f"OpenAPI route drift: missing={missing!r}, unexpected={unexpected!r}"
        )


def _response(schema: str, description: str = "Success") -> dict[str, object]:
    return {
        "description": description,
        "content": {JSON: {"schema": {"$ref": f"#/components/schemas/{schema}"}}},
    }


def _error(description: str) -> dict[str, object]:
    return {"description": description, "content": ERROR_CONTENT}


def _path_parameter(name: str, schema: dict[str, object]) -> dict[str, object]:
    return {
        "name": name,
        "in": "path",
        "required": True,
        "schema": schema,
    }


def _public_id_schema() -> dict[str, object]:
    from botified_asr.contracts import PUBLIC_ID_PATTERN

    return {"type": "string", "pattern": f"^{PUBLIC_ID_PATTERN}$"}


def _model_truth() -> tuple[list[str], int, str]:
    from botified_asr.api import _model_objects

    models = _model_objects()
    model_ids = [model["id"] for model in models]
    created_values = {model["created"] for model in models}
    owner_values = {model["owned_by"] for model in models}
    if (
        any(type(model_id) is not str for model_id in model_ids)
        or len(created_values) != 1
        or len(owner_values) != 1
    ):
        raise RuntimeError("model metadata is not representable in OpenAPI")
    created = created_values.pop()
    owner = owner_values.pop()
    if type(created) is not int or type(owner) is not str:
        raise RuntimeError("model metadata is invalid")
    return model_ids, created, owner


def _speaker_form(*, samples_required: bool) -> dict[str, object]:
    from botified_asr.api import MAX_SPEAKER_SAMPLE_BYTES
    from botified_asr.speaker_profiles import (
        MAX_SPEAKER_SAMPLES,
        MIN_SPEAKER_SAMPLES,
        SPEAKER_PROFILE_DESCRIPTION_MAX_CHARS,
        SPEAKER_PROFILE_NAME_MAX_CHARS,
    )

    required = ["name"]
    if samples_required:
        required.append("samples[]")
    description = (
        "Optional description. Omit or send an empty value for no description."
        if samples_required
        else "Omit to preserve the current description; send an empty value to clear it."
    )
    return {
        "type": "object",
        "required": required,
        "properties": {
            "name": {
                "type": "string",
                "description": (
                    "After surrounding whitespace is trimmed, must contain "
                    f"1 to {SPEAKER_PROFILE_NAME_MAX_CHARS} characters."
                ),
            },
            "description": {
                "type": "string",
                "maxLength": SPEAKER_PROFILE_DESCRIPTION_MAX_CHARS,
                "description": description,
            },
            "samples[]": {
                "type": "array",
                "minItems": MIN_SPEAKER_SAMPLES,
                "maxItems": MAX_SPEAKER_SAMPLES,
                "items": {
                    "type": "string",
                    "format": "binary",
                    "minLength": 1,
                    "maxLength": MAX_SPEAKER_SAMPLE_BYTES,
                    "description": (
                        "A non-empty audio sample with a 20 MiB byte limit."
                    ),
                },
            },
        },
        "additionalProperties": False,
    }


