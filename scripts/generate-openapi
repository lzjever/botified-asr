def _active_job_schema(status: str) -> dict[str, object]:
    return {
        "type": "object",
        "required": ["id", "status", "progress"],
        "properties": {
            "id": _public_id_schema(),
            "status": {"type": "string", "const": status},
            "progress": {"$ref": "#/components/schemas/JobProgress"},
        },
        "additionalProperties": False,
    }


def _transcription_form() -> dict[str, object]:
    from botified_asr.canonical_options import (
        CHUNKING_STRATEGY_VALUES,
        INCLUDE_VALUES,
        LANGUAGE_VALUES,
        MODEL_VALUES,
        RESPONSE_FORMAT_VALUES,
    )
    from botified_asr.contracts import PUBLIC_ID_PATTERN

    file_schema = {
        "type": "string",
        "format": "binary",
        "description": (
            "Audio input; upload-size and duration limits are deployment-configured."
        ),
    }
    language_schema = {
        "type": "string",
        "enum": list(LANGUAGE_VALUES),
    }
    chunking_schema = {
        "type": "string",
        "enum": list(CHUNKING_STRATEGY_VALUES),
    }
    include_schema = {
        "type": "array",
        "items": {"type": "string", "enum": list(INCLUDE_VALUES)},
    }
    known_speakers_schema = {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": True,
        "items": {
            "type": "string",
            "pattern": f"^{PUBLIC_ID_PATTERN}$",
        },
    }
    sensevoice_model, diarized_model = MODEL_VALUES
    json_format, text_format, verbose_format, diarized_format = (
        RESPONSE_FORMAT_VALUES
    )
    (auto_chunking,) = CHUNKING_STRATEGY_VALUES
    common = {
        "file": file_schema,
        "language": language_schema,
        "chunking_strategy": chunking_schema,
    }
    return {
        "description": (
            "sensevoice-diarize requires explicit chunking_strategy=auto and "
            "response_format=diarized_json; known_speaker_ids[] is only valid "
            "for that model. response_format=text cannot be combined with "
            "include[]."
        ),
        "oneOf": [
            {
                "title": "SenseVoice JSON request",
                "type": "object",
                "required": ["file", "model"],
                "properties": {
                    **common,
                    "model": {"type": "string", "const": sensevoice_model},
                    "response_format": {
                        "type": "string",
                        "enum": [json_format, verbose_format],
                    },
                    "include[]": include_schema,
                },
                "additionalProperties": False,
            },
            {
                "title": "SenseVoice text request",
                "type": "object",
                "required": ["file", "model", "response_format"],
                "properties": {
                    **common,
                    "model": {"type": "string", "const": sensevoice_model},
                    "response_format": {
                        "type": "string",
                        "const": text_format,
                    },
                },
                "additionalProperties": False,
            },
            {
                "title": "SenseVoice diarized request",
                "type": "object",
                "required": [
                    "file",
                    "model",
                    "response_format",
                    "chunking_strategy",
                ],
                "properties": {
                    **common,
                    "model": {
                        "type": "string",
                        "const": diarized_model,
                    },
                    "response_format": {
                        "type": "string",
                        "const": diarized_format,
                    },
                    "chunking_strategy": {
                        "type": "string",
                        "const": auto_chunking,
                    },
                    "include[]": include_schema,
                    "known_speaker_ids[]": known_speakers_schema,
                },
                "additionalProperties": False,
            },
        ],
    }


def _document(version: str) -> dict[str, object]:
    common_errors = {
        "400": _error("Invalid request"),
        "401": _error("Authentication failed"),
        "404": _error("Not found"),
        "409": _error("Conflict"),
        "413": _error("Request too large"),
        "422": _error("Request cannot be processed"),
        "429": _error("Capacity is temporarily unavailable"),
        "500": _error("Internal server error"),
        "503": _error("Service is unavailable"),
    }
    speaker_id = _path_parameter("speaker_id", _public_id_schema())
    job_id = _path_parameter("job_id", _public_id_schema())
    model_ids, _, _ = _model_truth()
    model_id = _path_parameter(
        "model_id",
        {"type": "string", "enum": model_ids},
    )
    speaker_post = _speaker_form(samples_required=True)
    speaker_put = _speaker_form(samples_required=False)
    return {
        "openapi": "3.1.0",
        "info": {"title": "Botified ASR API", "version": version},
        "security": [{"BearerAuth": []}],
        "paths": {
            "/health/live": {
                "get": {
                    "operationId": "getHealthLive",
                    "security": [],
                    "responses": {"200": _response("LiveHealth")},
                }
            },
            "/health/ready": {
                "get": {
                    "operationId": "getHealthReady",
                    "responses": {
                        "200": _response("ReadyHealth"),
                        "401": common_errors["401"],
                        "503": common_errors["503"],
                    },
                }
            },
            "/v1/models": {
                "get": {
                    "operationId": "listModels",
                    "responses": {
                        "200": _response("ModelList"),
                        "401": common_errors["401"],
                    },
                }
            },
            "/v1/models/{model_id}": {
                "get": {
                    "operationId": "getModel",
                    "parameters": [model_id],
                    "responses": {
                        "200": _response("Model"),
                        "401": common_errors["401"],
                        "404": common_errors["404"],
                    },
                }
            },
            "/v1/speakers": {
                "get": {
                    "operationId": "listSpeakers",
                    "responses": {
                        "200": _response("SpeakerList"),
                        "401": common_errors["401"],
                        "500": common_errors["500"],
                        "503": common_errors["503"],
                    },
                },
                "post": {
                    "operationId": "createSpeaker",
                    "requestBody": {
                        "required": True,
                        "content": {MULTIPART: {"schema": speaker_post}},
                    },
                    "responses": {
                        "201": _response("Speaker", "Speaker created"),
                        **{
                            status: common_errors[status]
                            for status in (
                                "400",
                                "401",
                                "409",
                                "413",
                                "429",
                                "500",
                                "503",
                            )
                        },
                    },
                },
            },
            "/v1/speakers/{speaker_id}": {
                "get": {
                    "operationId": "getSpeaker",
                    "parameters": [speaker_id],
                    "responses": {
                        "200": _response("Speaker"),
                        "401": common_errors["401"],
                        "404": common_errors["404"],
                        "500": common_errors["500"],
                        "503": common_errors["503"],
                    },
                },
                "put": {
                    "operationId": "updateSpeaker",
                    "parameters": [speaker_id],
                    "requestBody": {
                        "required": True,
                        "content": {MULTIPART: {"schema": speaker_put}},
                    },
                    "responses": {
                        "200": _response("Speaker"),
                        **{
                            status: common_errors[status]
                            for status in (
                                "400",
                                "401",
                                "404",
                                "409",
                                "413",
                                "429",
                                "500",
                                "503",
                            )
                        },
                    },
                },
                "delete": {
                    "operationId": "deleteSpeaker",
                    "parameters": [speaker_id],
                    "responses": {
                        "204": {"description": "Speaker deleted"},
                        "401": common_errors["401"],
                        "404": common_errors["404"],
                        "500": common_errors["500"],
                        "503": common_errors["503"],
                    },
                },
            },
            "/v1/audio/transcriptions": {
                "post": {
                    "operationId": "createTranscription",
                    "description": (
                        "Transcribes synchronously unless Prefer contains "
                        "respond-async. Upload-size and duration limits are "
                        "deployment-configured."
                    ),
                    "parameters": [
                        {
                            "name": "Prefer",
                            "in": "header",
                            "required": False,
                            "schema": {"type": "string"},
                        }
                    ],
                    "requestBody": {
                        "required": True,
                        "content": {
                            MULTIPART: {"schema": _transcription_form()}
                        },
                    },
                    "responses": {
                        "200": {
                            "description": "Synchronous transcription",
                            "content": {
                                JSON: {
                                    "schema": {
                                        "$ref": (
                                            "#/components/schemas/"
                                            "JsonTranscriptionResult"
                                        )
                                    }
                                },
                                "text/plain": {"schema": {"type": "string"}},
                            },
                        },
                        "202": {
                            **_response("JobAccepted", "Job accepted"),
                            "headers": {
                                "Location": {
                                    "required": True,
                                    "schema": {"type": "string"},
                                },
                                "Preference-Applied": {
                                    "required": True,
                                    "schema": {
                                        "type": "string",
                                        "const": "respond-async",
                                    },
                                },
                            },
                        },
                        **common_errors,
                    },
                }
            },
            "/v1/audio/transcriptions/{job_id}": {
                "get": {
                    "operationId": "getTranscriptionJob",
                    "parameters": [job_id],
                    "responses": {
                        "200": _response("TerminalJob"),
                        "202": _response("ActiveJob", "Job is active"),
                        "401": common_errors["401"],
                        "404": common_errors["404"],
                        "500": common_errors["500"],
                        "503": common_errors["503"],
                    },
                },
                "delete": {
                    "operationId": "deleteTranscriptionJob",
                    "parameters": [job_id],
                    "responses": {
                        "202": _response(
                            "CancellationAccepted",
                            "Cancellation accepted",
                        ),
                        "204": {"description": "Terminal job deleted"},
                        "401": common_errors["401"],
                        "404": common_errors["404"],
                        "500": common_errors["500"],
                        "503": common_errors["503"],
                    },
                },
            },
        },
        "components": {
            "securitySchemes": {
                "BearerAuth": {"type": "http", "scheme": "bearer"}
            },
            "schemas": _schemas(),
        },
    }


def _write_atomic(output: Path, content: bytes) -> None:
    if output.is_symlink():
        raise RuntimeError("Output must not be a symbolic link")
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{output.name}.",
        suffix=".tmp",
        dir=output.parent,
    )
    try:
        with os.fdopen(descriptor, "wb") as temporary:
            temporary.write(content)
            os.fchmod(temporary.fileno(), 0o644)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_name, output)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: generate-openapi OUTPUT")
    project_root = Path(__file__).resolve(strict=True).parent.parent
    output = Path(sys.argv[1])
    sys.path.insert(0, str(project_root / "src"))
    document = _document(_project_version(project_root))
    _validate_runtime_routes(project_root, document)
    content = (
        json.dumps(
            document,
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
            allow_nan=False,
        ).encode("utf-8")
        + b"\n"
    )
    _write_atomic(output, content)


if __name__ == "__main__":
    main()
